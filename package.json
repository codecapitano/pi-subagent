{
  "name": "pi-subagent",
  "version": "0.4.0",
  "description": "Parallel subagents for the Pi coding agent, with a shared FIFO limiter and bounded output.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": "github:codecapitano/pi-subagent",
  "scripts": {
    "test": "node --test --test-timeout=30000 *.test.mjs"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "subagents"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "files": [
    "index.ts",
    "agents.ts",
    "lifecycle.mjs",
    "output.mjs",
    "agents",
    "README.md",
    "LICENSE"
  ]
}
